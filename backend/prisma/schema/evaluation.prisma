model Evaluation {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @unique @db.Uuid

  status       EvaluationStatus @default(PENDING)
  totalMarks   Decimal?         @db.Decimal(10, 2)
  awardedMarks Decimal?         @db.Decimal(10, 2)
  percentage   Decimal?         @db.Decimal(6, 2)

  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission Submission       @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  items      EvaluationItem[]

  @@index([status])
}
