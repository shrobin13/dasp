model Application {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @db.Uuid
  candidateId  String  @db.Uuid
  jobId        String? @db.Uuid
  assessmentId String? @db.Uuid

  status ApplicationStatus @default(APPLIED)

  // Snapshot of the candidate information submitted for this application.
  // This prevents later global profile changes from rewriting recruitment history.
  profileSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate  Candidate   @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  invitations Invitation[]
  attempts    AssessmentAttempt[]

  @@unique([companyId, candidateId, jobId])
  @@index([companyId, status])
  @@index([companyId, candidateId])
  @@index([companyId, jobId])
  @@index([companyId, assessmentId])
}
