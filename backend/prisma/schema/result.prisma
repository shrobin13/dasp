model Result {
  id        String @id @default(uuid()) @db.Uuid
  attemptId String @unique @db.Uuid

  status       ResultStatus @default(PENDING)
  totalMarks   Decimal      @db.Decimal(10, 2)
  awardedMarks Decimal      @db.Decimal(10, 2)
  percentage   Decimal      @db.Decimal(6, 2)
  passingScore Decimal?     @db.Decimal(8, 2)
  passed       Boolean?

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([passed])
}
