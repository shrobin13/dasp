model AssessmentAttempt {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  candidateId   String @db.Uuid
  assessmentId  String @db.Uuid

  attemptNumber Int
  status        AttemptStatus @default(NOT_STARTED)

  startedAt   DateTime?
  expiresAt   DateTime?
  submittedAt DateTime?
  evaluatedAt DateTime?

  // Captures the assessment configuration used by this attempt.
  configSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  assessment  Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  answers    Answer[]
  submission Submission?
  result     Result?

  @@unique([applicationId, attemptNumber])
  @@index([candidateId, status])
  @@index([assessmentId, status])
  @@index([applicationId, status])
  @@index([status, expiresAt])
}
